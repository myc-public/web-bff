# Modele des variables locales. Copier en local/.env (ignore par Git) et renseigner les secrets.
# Lu par Docker Compose (local/compose.yaml) ET par le BFF lance par mvn (spring.config.import).
# Memes noms que la ConfigMap / le Secret OpenShift de l'instance.
BFF_INSTANCE=web-bff-customers
SERVER_PORT=8090
# Keycloak local (gitops-platform/local/keycloak) : en dev, emetteur public et URL interne sont la meme adresse
OIDC_ISSUER_URI=http://localhost:8180/realms/myc-customers
OIDC_INTERNAL_URI=http://localhost:8180/realms/myc-customers
OIDC_CLIENT_ID=web-bff
# = WEB_BFF_CLIENT_SECRET de gitops-platform/local/keycloak/.env
OIDC_CLIENT_SECRET=changeme
# Front servi par Vite (le proxy Vite envoie /bff vers ce BFF)
BFF_ALLOWED_ORIGINS=http://localhost:5173
# API en mode dev (inner-donation-api, mvn spring-boot:run)
API_BASE_URL=http://localhost:8080
REDIS_HOST=localhost
REDIS_PORT=6379
# Mot de passe de l'utilisateur Redis BFF_INSTANCE (32 caracteres aleatoires) :
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
REDIS_PASSWORD=changeme
